#!/usr/bin/env bash
# A fake of each macOS program the macOS probes run, for the Linux selftest (run.sh).
# run.sh links it into $FAKE_BIN under each program's name. Its state is files under
# $FAKE_STATE, which the tests set; every call is logged to $FAKE_STATE/log. Output
# formats follow what the probes parse; the automationmodetool wording is a guess
# until the hosted run records the real one (docs/spikes/macos-p0.md).

set -u
S=$FAKE_STATE
NAME=${0##*/}
CALLER_PATH=$PATH
PATH=$FAKE_REAL_PATH
printf '%s %s\n' "$NAME" "$*" >>"$S/log"
has() { [ -e "$S/$1" ]; }

case "$NAME" in
    uname) echo arm64 ;;
    sw_vers)
        case "$1" in
            -productVersion) echo 26.0 ;;
            -buildVersion) echo 25A100 ;;
        esac
        ;;
    xcodebuild) printf 'Xcode 26.0\nBuild version 17A100\n' ;;
    launchctl) [ "$1" = managername ] && echo Aqua ;;
    stat) echo runner ;;
    csrutil) echo 'System Integrity Protection status: disabled.' ;;
    pgrep) cat "$S/launchd_sim" 2>/dev/null ;;
    id)
        case "${1-}" in
            -u) echo "${FAKE_UID:-501}" ;;
            -Gn) echo 'staff admin' ;;
            *) has "user_$1" ;;
        esac
        ;;
    sudo)
        # sudo -n [-u USER] CMD...: runs CMD as root (or USER) in the fake.
        [ "$1" = -n ] && shift
        if [ "$1" = -u ]; then
            export FAKE_UID=502 FAKE_AS="$2"
            shift 2
        else
            export FAKE_UID=0
        fi
        PATH=$CALLER_PATH exec "$@"
        ;;
    automationmodetool)
        auth=$(cat "$S/auth")
        case "${1-}" in
            "")
                if [ "$auth" = weird ]; then
                    echo 'Something else entirely.'
                    exit 0
                fi
                echo 'Automation Mode is disabled.'
                if [ "$auth" = not_required ]; then
                    echo 'This device does not require user authentication to enable Automation Mode.'
                else
                    echo 'This device requires user authentication to enable Automation Mode.'
                fi
                ;;
            enable-automationmode-without-authentication)
                [ "${FAKE_UID:-501}" = 0 ] || exit 1
                has hang_enable && sleep 30
                echo not_required >"$S/auth"
                ;;
            disable-automationmode-without-authentication)
                [ "${FAKE_UID:-501}" = 0 ] || exit 1
                has disable_noop || echo required >"$S/auth"
                ;;
        esac
        ;;
    sysadminctl)
        [ "${FAKE_UID:-501}" = 0 ] || exit 1
        case "$1" in
            -addUser) : >"$S/user_$2" ;;
            -deleteUser)
                rm -f "$S/user_$2"
                if has delete_resets; then echo required >"$S/auth"; fi
                ;;
        esac
        ;;
    sandbox-exec)
        # sandbox-exec -p PROFILE CMD...: a profile naming CoreSimulatorService blocks
        # the fake simctl, unless the test says the deny is ignored.
        case "$2" in
            *CoreSimulatorService*) has deny_ignored || export FAKE_SIM_DENIED=1 ;;
        esac
        shift 2
        PATH=$CALLER_PATH exec "$@"
        ;;
    xcrun)
        [ "$1" = simctl ] || exit 1
        shift
        set_dir=
        if [ "$1" = --set ]; then
            set_dir=$2
            shift 2
        fi
        if [ -n "${FAKE_SIM_DENIED-}" ]; then
            echo 'Unable to locate CoreSimulatorService' >&2
            exit 163
        fi
        verb=$1
        shift
        case "$verb" in
            list)
                case "$1" in
                    runtimes)
                        echo '== Runtimes =='
                        echo 'iOS 18.6 (18.6 - 22G86) - com.apple.CoreSimulator.SimRuntime.iOS-18-6'
                        echo 'iOS 26.0 (26.0 - 23A339) - com.apple.CoreSimulator.SimRuntime.iOS-26-0'
                        echo 'iOS 26.1 (26.1 - 23B1) - com.apple.CoreSimulator.SimRuntime.iOS-26-1 (unavailable, runtime missing)'
                        ;;
                    devicetypes)
                        echo '== Device Types =='
                        echo 'iPad Air 11-inch (M3) (com.apple.CoreSimulator.SimDeviceType.iPad-Air-11-inch-M3)'
                        echo 'iPhone 17 Pro (com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro)'
                        ;;
                esac
                ;;
            create)
                printf '%s %s\n' "$2" "$3" >"$S/created"
                mkdir -p "$set_dir/0A1B2C3D-0000-4000-8000-000000000001"
                echo 0A1B2C3D-0000-4000-8000-000000000001
                ;;
            boot) : >"$S/booted" ;;
            bootstatus) has booted || exit 1 ;;
            io)
                has booted || exit 1
                if has bad_png; then echo 'not a png' >"$3"; else printf '\211PNG\r\n\032\nrest' >"$3"; fi
                ;;
            shutdown) rm -f "$S/booted" ;;
            delete) rm -rf "${set_dir:?}/$1" ;;
        esac
        ;;
    sqlite3)
        # sqlite3 DB "CREATE ...; INSERT ... VALUES ('a', 'b', 2);" writes the row as
        # "a|b|2"; sqlite3 -readonly DB QUERY prints a planted database's rows.
        if [ "$1" = -readonly ]; then
            [ -f "$2" ] || {
                echo 'Error: unable to open database file' >&2
                exit 14
            }
            has control_empty && case "$2" in *tcc-control.db) exit 0 ;; esac
            cat "$2"
        else
            printf '%s\n' "$2" | sed -n "s/.*VALUES ('\([^']*\)', '\([^']*\)', \([0-9]*\)).*/\1|\2|\3/p" >"$1"
        fi
        ;;
    *)
        echo "fakecmd: no fake for $NAME" >&2
        exit 127
        ;;
esac
