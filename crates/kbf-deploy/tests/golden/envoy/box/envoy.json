{
  "admin": {
    "address": {
      "socket_address": {
        "address": "127.0.0.1",
        "port_value": 9901
      }
    }
  },
  "static_resources": {
    "clusters": [
      {
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 14,
              "max_pending_requests": 65536,
              "max_requests": 65536,
              "max_retries": 65536,
              "priority": "DEFAULT"
            }
          ]
        },
        "close_connections_on_host_health_failure": false,
        "common_lb_config": {
          "healthy_panic_threshold": {
            "value": 0
          }
        },
        "connect_timeout": "1s",
        "health_checks": [
          {
            "grpc_health_check": {
              "service_name": ""
            },
            "healthy_threshold": 1,
            "interval": "1s",
            "no_traffic_interval": "1s",
            "timeout": "1s",
            "unhealthy_threshold": 2
          }
        ],
        "lb_policy": "ROUND_ROBIN",
        "load_assignment": {
          "cluster_name": "kbf_reapi",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 18980
                      }
                    },
                    "hostname": "kbf.example.internal"
                  },
                  "metadata": {
                    "filter_metadata": {
                      "envoy.transport_socket_match": {
                        "server": "kbf.example.internal"
                      }
                    }
                  }
                },
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 18990
                      }
                    },
                    "hostname": "kbf.example.internal"
                  },
                  "metadata": {
                    "filter_metadata": {
                      "envoy.transport_socket_match": {
                        "server": "kbf.example.internal"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "kbf_reapi",
        "transport_socket": {
          "name": "envoy.transport_sockets.tls",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
            "common_tls_context": {
              "alpn_protocols": [
                "h2"
              ],
              "validation_context": {
                "trusted_ca": {
                  "filename": "/etc/kbf/tls/ca.pem"
                }
              }
            }
          }
        },
        "transport_socket_matches": [
          {
            "match": {
              "server": "kbf.example.internal"
            },
            "name": "kbf.example.internal",
            "transport_socket": {
              "name": "envoy.transport_sockets.tls",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
                "common_tls_context": {
                  "alpn_protocols": [
                    "h2"
                  ],
                  "validation_context": {
                    "match_typed_subject_alt_names": [
                      {
                        "matcher": {
                          "exact": "kbf.example.internal"
                        },
                        "san_type": "DNS"
                      }
                    ],
                    "trusted_ca": {
                      "filename": "/etc/kbf/tls/ca.pem"
                    }
                  }
                },
                "sni": "kbf.example.internal"
              }
            }
          }
        ],
        "type": "STATIC",
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "explicit_http_config": {
              "http2_protocol_options": {
                "connection_keepalive": {
                  "interval": "30s",
                  "timeout": "20s"
                },
                "max_concurrent_streams": 10000
              }
            }
          }
        }
      },
      {
        "circuit_breakers": {
          "thresholds": [
            {
              "max_connections": 65536,
              "priority": "DEFAULT"
            }
          ]
        },
        "close_connections_on_host_health_failure": false,
        "common_lb_config": {
          "healthy_panic_threshold": {
            "value": 0
          }
        },
        "connect_timeout": "1s",
        "health_checks": [
          {
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/readyz"
            },
            "interval": "1s",
            "no_traffic_interval": "1s",
            "timeout": "1s",
            "unhealthy_threshold": 2
          }
        ],
        "lb_policy": "ROUND_ROBIN",
        "load_assignment": {
          "cluster_name": "kbf_workers",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 18981
                      }
                    },
                    "health_check_config": {
                      "port_value": 18982
                    }
                  }
                },
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 18991
                      }
                    },
                    "health_check_config": {
                      "port_value": 18992
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "kbf_workers",
        "type": "STATIC"
      }
    ],
    "listeners": [
      {
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8980
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "codec_type": "AUTO",
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ],
                  "route_config": {
                    "name": "reapi",
                    "virtual_hosts": [
                      {
                        "domains": [
                          "*"
                        ],
                        "name": "kbf",
                        "routes": [
                          {
                            "match": {
                              "grpc": {},
                              "path": "/build.bazel.remote.execution.v2.Execution/Execute"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "idle_timeout": "0s",
                              "retry_policy": {
                                "num_retries": 2,
                                "retry_on": "connect-failure,refused-stream"
                              },
                              "timeout": "0s"
                            }
                          },
                          {
                            "match": {
                              "grpc": {},
                              "path": "/build.bazel.remote.execution.v2.Execution/WaitExecution"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "idle_timeout": "0s",
                              "retry_policy": {
                                "num_retries": 2,
                                "retry_on": "connect-failure,refused-stream"
                              },
                              "timeout": "0s"
                            }
                          },
                          {
                            "match": {
                              "grpc": {},
                              "prefix": "/build.bazel.remote.execution.v2.Capabilities/"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "retry_policy": {
                                "num_retries": 2,
                                "retry_on": "connect-failure,refused-stream"
                              },
                              "timeout": "0s"
                            }
                          },
                          {
                            "match": {
                              "grpc": {},
                              "prefix": "/build.bazel.remote.execution.v2.ContentAddressableStorage/"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "retry_policy": {
                                "num_retries": 2,
                                "retry_on": "connect-failure,refused-stream"
                              },
                              "timeout": "0s"
                            }
                          },
                          {
                            "match": {
                              "grpc": {},
                              "prefix": "/build.bazel.remote.execution.v2.ActionCache/"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "retry_policy": {
                                "num_retries": 2,
                                "retry_on": "connect-failure,refused-stream"
                              },
                              "timeout": "0s"
                            }
                          },
                          {
                            "match": {
                              "grpc": {},
                              "prefix": "/google.bytestream.ByteStream/"
                            },
                            "route": {
                              "cluster": "kbf_reapi",
                              "timeout": "0s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "stat_prefix": "reapi",
                  "stream_idle_timeout": "7200s"
                }
              }
            ],
            "transport_socket": {
              "name": "envoy.transport_sockets.tls",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext",
                "common_tls_context": {
                  "alpn_protocols": [
                    "h2"
                  ],
                  "tls_certificates": [
                    {
                      "certificate_chain": {
                        "filename": "/etc/kbf/tls/reapi.pem"
                      },
                      "private_key": {
                        "filename": "/etc/kbf/tls/reapi.key"
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        "name": "reapi"
      },
      {
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8981
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.tcp_proxy",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy",
                  "cluster": "kbf_workers",
                  "idle_timeout": "0s",
                  "stat_prefix": "worker"
                }
              }
            ]
          }
        ],
        "name": "worker"
      }
    ]
  }
}
