# Rendered by `kbf-deploy linux render-units`; installed as
# /etc/systemd/system/kbf-daemon.service (kbf docs/deploy/storage-node.md,
# "Converged units").
[Unit]
Description=kbf build farm node daemon
Wants=network-online.target
After=network-online.target kbf-server.service

[Service]
User=@KBF_USER@
Slice=kbf.slice
# The daemon manages its own cgroup: supervisor/ for itself, actions/ for builds.
Delegate=yes
# Equal to --supervisor-memory-min-mib.
MemoryMin=@DAEMON_MEMORY_MIN@
# Above the server's -925; build containers get 0 back from the driver.
OOMScoreAdjust=-900
CPUWeight=200
# No MemorySwapMax=: leases may swap (the host's swapfile is for them); the
# daemon's swap watch kills a lease that swaps at its own cap.
Environment=XDG_RUNTIME_DIR=/run/user/@KBF_UID@
ExecStart=@KBF_BIN_DIR@/kbf-daemon \
    --driver=container \
    --oci-runtime=/usr/bin/crun \
    --server=https://@KBF_HOST_NAME@:@KBF_WORKER_PORT@ \
    --cas=https://@KBF_HOST_NAME@:@KBF_WORKER_PORT@ \
    --ca-cert=@KBF_ETC@/ca.pem \
    --cert=@KBF_ETC@/node.pem \
    --key=@KBF_ETC@/node.key \
    --node-id=@KBF_NODE_ID@ \
    --data-dir=@KBF_DATA_DIR@ \
@DAEMON_IMAGE_ARGS@
    --actions-memory-max-gib=@ACTIONS_MEMORY_MAX_GIB@ \
    --supervisor-memory-min-mib=@KBF_DAEMON_MEMORY_MIN_MIB@
Restart=on-failure

[Install]
WantedBy=multi-user.target
